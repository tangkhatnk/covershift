# Supabase → nút Connect (hoặc Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Key CÔNG KHAI: publishable key (sb_publishable_...). Project cũ có thể còn anon key (eyJ...). Tên biến giữ nguyên.
# KHÔNG dùng secret key (sb_secret_...) hay service_role ở đây.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Địa chỉ gốc của web (không có dấu / ở cuối). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
